<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <remove name="Youtube FastCGI" />
      <add name="Youtube FastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\dev\Youtube-mp4-download\.venv\Scripts\python.exe|C:\dev\Youtube-mp4-download\.venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
  </system.webServer>

  <appSettings>
    <add key="WSGI_HANDLER" value="run.app" />
    <add key="PYTHONPATH" value="C:\dev\Youtube-mp4-download" />
    <add key="WSGI_LOG" value="C:\dev\Youtube-mp4-download\logs\wfastcgi.log" />
    <add key="WSGI_RESTART_FILE_REGEX" value=".*(\.py|\.config)$" />
  </appSettings>
</configuration>
